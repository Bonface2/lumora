# ── Database ──────────────────────────────────────────────────────────────────
# Production (Docker): use the service name from docker-compose.prod.yml
DATABASE_URL="postgresql://lumora:YOUR_DB_PASSWORD@postgres:5432/lumora"
DIRECT_URL="postgresql://lumora:YOUR_DB_PASSWORD@postgres:5432/lumora"
# DB_PASSWORD is read by docker-compose.prod.yml
DB_PASSWORD="your-strong-password"

# ── NextAuth ──────────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="same value as AUTH_SECRET"
NEXTAUTH_URL="https://lumora.co.ke"

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── IntaSend (payments + payouts) ─────────────────────────────────────────────
# Keys: https://payment.intasend.com → Settings → API Keys
INTASEND_SECRET_KEY="ISSecretKey_live_..."
NEXT_PUBLIC_INTASEND_PUBLIC_KEY="ISPubKey_live_..."
# Must match the challenge token set in your IntaSend dashboard → Webhooks
INTASEND_WEBHOOK_CHALLENGE="lumora-webhook-challenge"
INTASEND_TEST_MODE="false"

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="Lumora <noreply@lumora.co.ke>"
ADMIN_EMAIL="admin@lumora.co.ke"
SUPPORT_EMAIL="support@lumora.co.ke"

# ── Uploadthing (image uploads) ───────────────────────────────────────────────
UPLOADTHING_TOKEN=""

# ── Scan link signing ─────────────────────────────────────────────────────────
SCAN_SECRET="generate-with: openssl rand -base64 32"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://lumora.co.ke"

# ── Load testing (never enable in production) ─────────────────────────────────
# Set LOAD_TEST_MODE=true only temporarily while running k6 tests.
# Generate secret with: openssl rand -hex 32
LOAD_TEST_MODE="false"
LOAD_TEST_SECRET=""
