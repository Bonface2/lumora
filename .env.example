# Database
# Local dev: direct connection is fine
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lumora"
# Production (serverless): route through PgBouncer or Prisma Accelerate to
# avoid exhausting Postgres connection limits.
# PgBouncer: DATABASE_URL="postgresql://USER:PASSWORD@PGBOUNCER_HOST:6432/lumora?pgbouncer=true&connection_limit=1"
# Prisma Accelerate: DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
# When using a pooler, also set DIRECT_URL for migrations:
# DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/lumora"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Resend (email)
RESEND_API_KEY="re_..."
EMAIL_FROM="Lumora <noreply@yourdomain.com>"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Uploadthing (image uploads)
UPLOADTHING_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
